<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Four-point chrome star: slender concave points centred in the 108dp tile. -->
    <path
        android:pathData="M54,10 C56,40 68,52 98,54 C68,56 56,68 54,98 C52,68 40,56 10,54 C40,52 52,40 54,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.30" android:color="#FFD3D8DF" />
                <item android:offset="0.50" android:color="#FF767D88" />
                <item android:offset="0.68" android:color="#FFEDF0F4" />
                <item android:offset="1.0" android:color="#FF9BA2AD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular bloom at the core. -->
    <path android:pathData="M54,54 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="6">
                <item android:offset="0.0" android:color="#B3FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ridges running from the centre to each tip. -->
    <path
        android:pathData="M54,54 L54,10 M54,54 L98,54 M54,54 L54,98 M54,54 L10,54"
        android:strokeColor="#66000000"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />
</vector>
