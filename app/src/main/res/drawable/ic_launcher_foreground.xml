<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Four-point chrome star: slender concave points centred in the 108dp tile. -->
    <path
        android:pathData="M54,10 C56,40 68,52 98,54 C68,56 56,68 54,98 C52,68 40,56 10,54 C40,52 52,40 54,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.28" android:color="#FFE7EAEF" />
                <item android:offset="0.55" android:color="#FF8F96A2" />
                <item android:offset="0.78" android:color="#FFD9DDE4" />
                <item android:offset="1.0" android:color="#FF9AA1AC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular bloom at the core. -->
    <path android:pathData="M54,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="9">
                <item android:offset="0.0" android:color="#E6FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ridges running from the centre to each tip. -->
    <path
        android:pathData="M54,54 L54,10 M54,54 L98,54 M54,54 L54,98 M54,54 L10,54"
        android:strokeColor="#59000000"
        android:strokeWidth="1"
        android:strokeLineCap="round" />
</vector>
