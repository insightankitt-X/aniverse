<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Applied by the system splash screen, then replaced by Theme.AniVerse. -->
    <style name="Theme.AniVerse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AniVerse</item>
    </style>

    <!-- Colours come from Compose (Material 3), so the platform theme stays minimal. -->
    <style name="Theme.AniVerse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
